# Railway Production Environment Variables
# Copy this to .env file for local testing (do not commit .env to git)

# Django Settings Module (required for production)
DJANGO_SETTINGS_MODULE=cartoon_manager.settings_prod

# Security - generate a strong random key for production
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-secure-random-key

# Debug mode - must be False in production
DEBUG=False

# Allowed hosts - include your Railway domain and any custom domains
# Railway provides a domain like: your-app-name.railway.app
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1

# Database URL - Railway will provide this automatically when you add a PostgreSQL database
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://user:password@localhost:5432/memoon

# Optional: Force HTTPS redirects
SECURE_SSL_REDIRECT=True
